  default:
    description: All RTL (no testbenches)
    filesets: [inc, lib, ip_01_uart_usart, ip_02_spi, ip_03_i2c_i3c, ip_04_xspi_xip, ip_05_hyperram, ip_06_sdram_sram_nvsram, ip_07_nvpsram, ip_08_gpio, ip_09_i2s, ip_10_ledc, ip_11_jtag, ip_12_can, ip_13_eth_mac, ip_14_dvi_tmds, ip_15_dma_gdma, ip_16_gfx2d_dma, ip_17_mini_tpu, ip_18_rmt, ip_19_ir_txrx, ip_20_hub75, ip_21_par_if, ip_22_flex_ext_bus, ip_23_pio_engine, ip_24_timer_pwm, ip_25_plic_clint, ip_26_wdt_rtc, ip_27_sdmmc, ip_28_crypto, ip_29_cordic, ip_30_fft, ip_31_dsp_filter, ip_32_pka, ip_33_otp_trng_keymgr, ip_34_mipi_csi2_rx, ip_35_mipi_dsi_tx, ip_36_soc_sysctrl, ip_37_ipc_debug, ip_38_ddr_ctrl, ip_39_serdes_combo, ip_40_usb2_otg, ip_41_lpddr3_ctrl, ip_42_lpddr4_ctrl, ip_43_ddr_dimm_ctrl, ip_44_sdram_hp, ip_45_isp_lite, ip_46_lz4_jpeg_codec, ip_47_l2_cache, ip_48_iommu, ip_49_foc_motor, ip_50_smbus_pmbus, ip_51_axi_pmu_trace]

