.program ws2812
.side_set 1
; WS2812B 1-wire protocol: 10 ticks/bit (T0H=3/T0L=7, T1H=7/T1L=3).
; out_right=0, autopull=1 (pull_thresh=24).
.wrap_target
bitloop:
    out x, 1            side 0 [2]  ; 3 ticks low (stalls low when FIFO empty)
    jmp xz, do_zero     side 1 [2]  ; 3 ticks high
    jmp bitloop         side 1 [3]  ; bit=1: 4 more ticks high (7 high total)
do_zero:
    nop                 side 0 [3]  ; bit=0: 4 ticks low (+3 at top = 7 low total)
.wrap
